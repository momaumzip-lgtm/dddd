# Server only. Never commit .env.local or use NEXT_PUBLIC_* for secrets.
APP_NAME=마음 한걸음
APP_URL=http://127.0.0.1:3000
ALLOWED_ORIGIN=http://127.0.0.1:3000
# Independently generate at least 32 random characters.
SESSION_SECRET=
OPENAI_API_KEY=
# Lowest listed text price checked 2026-11-20; scheduled shutdown 2026-12-11.
# No automatic higher-priced fallback. Review and retest before shutdown.
OPENAI_MODEL=gpt-5-nano
# Netlify automatically provisions NETLIFY_DB_URL. No Redis account or token is needed.
# Local database testing: netlify dev (or use the isolated PGlite integration tests).
OPERATOR_NAME=maumzip
SUPPORT_CONTACT="010-6675-9496"
# Actual operator-approved notices; do not replace these with invented policy values.
TARGET_AGE_NOTICE="20~40대 중심"
DATA_PROCESSING_NOTICE=
# Set true only after checking hosting/APM request-body logging and retention settings.
HOST_LOG_POLICY_CONFIRMED=false
SESSION_MINUTE_LIMIT=6
SESSION_DAY_LIMIT=60
GLOBAL_DAY_LIMIT=300
MAX_INPUT_CHARS=1200
MAX_HISTORY_CHARS=12000
MAX_OUTPUT_TOKENS=1000

# Optional survey email. No actual responses are sent until all required settings are supplied.
RESEND_API_KEY=
SURVEY_FROM_EMAIL=
SURVEY_TO_EMAIL=
# Actual mailbox/provider retention and deletion policy, shown before separate survey consent.
SURVEY_RETENTION_NOTICE="운영자 메일함의 설문 응답은 접수일로부터 1년 보관 후 삭제합니다. 이메일 발송 서비스의 별도 보관·삭제 조건은 확인 중입니다."
SURVEY_DAY_LIMIT=300
